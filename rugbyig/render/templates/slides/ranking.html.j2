<div class="titulo">
  <h1>{{ s.titulo }}</h1>
  <div class="bajada">{{ s.sup }}</div>
</div>
<div class="cuerpo">
{% for j in s.filas %}
  {% set n = j.nombre|jugador %}
  <div class="fila">
    <div class="pos">{{ loop.index }}</div>
    <div>{% if j.equipo|escudo %}<img class="crest a" src="{{ j.equipo|escudo }}">{% endif %}</div>
    <div style="min-width:0">
      <div class="jug-nom">{{ n.completo }}</div>
      <div class="jug-eq">{{ j.equipo|corto }}{% if j.extra %} · {{ j.extra }}{% endif %}</div>
    </div>
    <div>
      <div class="pts">{{ j.valor }}<small>{{ s.unidad }}</small></div>
      {% if j.detalle %}<div class="det">{{ j.detalle }}</div>{% endif %}
    </div>
  </div>
{% endfor %}
</div>
