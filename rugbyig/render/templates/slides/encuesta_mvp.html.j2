{# Historia "Vota el MVP": 4 candidatos arriba y hueco libre abajo para el sticker de encuesta. #}
<style>
.enc-cands { display: grid; grid-template-columns: 1fr 1fr; gap: 22px; }
.enc-cand { position: relative; background: var(--panel); border: 2px solid var(--linea); border-radius: 18px; padding: 22px 22px 20px; display: flex; flex-direction: column; align-items: flex-start; gap: 8px; min-height: 300px; }
.enc-letra { position: absolute; top: 18px; right: 20px; width: 54px; height: 54px; border-radius: 50%; background: var(--acento); color: var(--sobre-acento); display: grid; place-items: center; font-family: var(--f-tit); font-size-adjust: cap-height 0.64; font-weight: 700; font-size: 34px; padding-top: 4px; }
.enc-cand .crest { width: 84px; height: 84px; padding: 8px; }
.enc-pila { font-size: 26px; color: var(--gris); margin-top: 6px; line-height: 1; }
.enc-ape { font-family: var(--f-tit); font-size-adjust: cap-height 0.64; font-weight: 600; font-size: 46px; line-height: .95; max-width: 100%; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.enc-eq { font-size: 26px; color: var(--gris); }
.enc-linea { font-size: 26px; color: var(--acento-txt); font-weight: 600; margin-top: auto; }
.enc-pide { margin-top: 44px; font-family: var(--f-tit); font-size-adjust: cap-height 0.64; font-weight: 600; font-size: 46px; text-align: center; }
.enc-hueco { margin: 18px auto 0; width: 820px; height: 330px; border: 3px dashed var(--linea); border-radius: 32px; }
</style>
<div class="titulo">
  <h1>Vota el MVP</h1>
  <div class="bajada">¿Quién fue el mejor de la jornada {{ s.jornada_n }}?</div>
</div>
<div class="cuerpo" style="margin-top: 60px">
  <div class="enc-cands">
  {% for c in s.candidatos %}
    {% set n = c.nombre|jugador %}
    <div class="enc-cand">
      <div class="enc-letra">{{ s.letras[loop.index0] }}</div>
      {% if c.equipo|escudo %}<img class="crest" src="{{ c.equipo|escudo }}">{% endif %}
      <div class="enc-pila">{{ n.nombre }}</div>
      <div class="enc-ape">{{ n.corto }}</div>
      <div class="enc-eq">{{ c.equipo|corto }}{% if c.posicion %} · {{ c.posicion }}{% endif %}</div>
      {% if c.linea %}<div class="enc-linea">{{ c.linea }}</div>{% endif %}
    </div>
  {% endfor %}
  </div>
  <div class="enc-pide">Vota aquí</div>
  <div class="enc-hueco"></div>
</div>
