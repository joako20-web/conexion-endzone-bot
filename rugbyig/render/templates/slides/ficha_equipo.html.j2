{# Ficha de un equipo. Estilos locales con las variables del tema. #}
<style>
.fe { flex: 1; display: flex; flex-direction: column; gap: 26px; margin-top: 26px; position: relative; z-index: 2; }
.fe-tit { font-family: var(--f-tit); font-size-adjust: cap-height var(--aj-tit, .64); }
.fe-num { font-family: var(--f-num, var(--f-tit)); font-size-adjust: cap-height var(--aj-num, .64); font-variant-numeric: tabular-nums; }
.fe-hero { display: grid; grid-template-columns: 200px 1fr; gap: 34px; align-items: center; }
.fe-hero .crest { width: 200px; height: 200px; padding: 20px; }
.fe-kick { font-size: 26px; font-weight: 600; letter-spacing: 3px; text-transform: uppercase; color: var(--acento-txt); }
.fe-nom { font-weight: 600; font-size: 96px; line-height: .86; margin-top: 8px; }
.fe-pos { font-size: 30px; color: var(--gris); margin-top: 12px; }
.fe-pos b { color: var(--texto); }
.fe-stats { display: grid; grid-template-columns: repeat(5, 1fr); border-top: 2px solid var(--linea); border-bottom: 2px solid var(--linea); }
.fe-stat { padding: 18px 0 14px; text-align: center; }
.fe-stat + .fe-stat { border-left: 1px solid var(--linea); }
.fe-stat b { display: block; font-size: 70px; line-height: .9; }
.fe-stat:first-child b { color: var(--acento-txt); }
.fe-stat span { font-size: 24px; color: var(--gris); letter-spacing: 1px; text-transform: uppercase; }
.fe-doble { display: grid; grid-template-columns: 1fr 1fr; gap: 30px; }
.fe-sub { font-size: 24px; font-weight: 600; letter-spacing: 3px; text-transform: uppercase; color: var(--gris); margin-bottom: 10px; }
.fe-racha { display: flex; gap: 10px; }
.fe-racha i { width: 58px; height: 58px; border-radius: 50%; display: grid; place-items: center; font-style: normal; font-weight: 700; font-size: 28px; color: var(--fondo); background: var(--apagado); }
.fe-racha i.G { background: #2f9e55; color: #fff; }
.fe-racha i.P { background: #d64035; color: #fff; }
.fe-racha i.E { background: #e7a92b; color: #111; }
.fe-mini { display: flex; gap: 34px; align-items: baseline; }
.fe-mini div b { font-size: 50px; }
.fe-mini div span { font-size: 24px; color: var(--gris); margin-left: 6px; }
.fe-res { display: grid; grid-template-columns: 54px 1fr auto 46px; align-items: center; gap: 12px; height: 64px; border-top: 1px solid var(--linea); }
.fe-res:first-of-type { border-top: 0; }
.fe-res .crest { width: 48px; height: 48px; padding: 5px; }
.fe-res .rv { font-size: 30px; font-weight: 600; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
.fe-res .rv small { font-size: 22px; color: var(--gris); font-weight: 500; margin-left: 6px; }
.fe-res .mc { font-size: 40px; }
.fe-res .ch { justify-self: end; width: 40px; height: 40px; border-radius: 8px; display: grid; place-items: center; font-weight: 700; font-size: 24px; }
.fe-res .ch.G { background: #2f9e55; color: #fff; }
.fe-res .ch.P { background: #d64035; color: #fff; }
.fe-res .ch.E { background: #e7a92b; color: #111; }
.fe-prox { border: 2px solid var(--linea); border-radius: 14px; padding: 18px 20px; display: grid; grid-template-columns: 84px 1fr; gap: 16px; align-items: center; background: var(--panel); }
.fe-prox .crest { width: 84px; height: 84px; padding: 8px; }
.fe-prox .rv { font-size: 40px; font-weight: 600; line-height: .95; }
.fe-prox .cu { font-size: 26px; color: var(--acento-txt); font-weight: 600; margin-top: 6px; }
.fe-prox .ca { font-size: 24px; color: var(--gris); margin-top: 2px; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
.fe-jug { display: grid; grid-template-columns: 1fr auto; align-items: baseline; height: 52px; border-top: 1px solid var(--linea); }
.fe-jug:first-of-type { border-top: 0; }
.fe-jug .n { font-size: 30px; font-weight: 600; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
.fe-jug .v { font-size: 42px; }
.fe-jug:first-of-type .v { color: var(--acento-txt); }
.fe-vacio { font-size: 26px; color: var(--gris); }
.f-historia .fe { gap: 40px; margin-top: 60px; }
.f-historia .fe-res { height: 82px; }
.f-historia .fe-jug { height: 70px; }
</style>
{% set f = s.fila %}
<div class="fe">
  <div class="fe-hero">
    {% if s.equipo|escudo %}<img class="crest" src="{{ s.equipo|escudo }}">{% else %}<span></span>{% endif %}
    <div>
      <div class="fe-kick">{{ s.liga }}</div>
      <div class="fe-nom fe-tit">{{ s.equipo|corto }}</div>
      {% if f %}<div class="fe-pos"><b>{{ f.posicion }}º de {{ s.n_equipos }}</b>{% if s.zona %} · {{ s.zona }}{% endif %}</div>{% endif %}
    </div>
  </div>

  {% if f %}
  <div class="fe-stats">
    <div class="fe-stat"><b class="fe-num">{{ f.pt }}</b><span>Puntos</span></div>
    <div class="fe-stat"><b class="fe-num">{{ f.pj }}</b><span>Jugados</span></div>
    <div class="fe-stat"><b class="fe-num">{{ f.pg }}-{{ f.pe }}-{{ f.pp }}</b><span>G-E-P</span></div>
    <div class="fe-stat"><b class="fe-num">{{ '%+d'|format(f.dt) if f.dt else 0 }}</b><span>Diferencia</span></div>
    <div class="fe-stat"><b class="fe-num">{{ f.bo + f.bd }}</b><span>Bonus</span></div>
  </div>
  <div class="fe-doble">
    <div>
      <div class="fe-sub">Racha</div>
      <div class="fe-racha">{% for r in s.racha %}<i class="{{ r }}">{{ r }}</i>{% else %}<span class="fe-vacio">Sin partidos jugados</span>{% endfor %}</div>
    </div>
    <div class="fe-mini">
      <div><b class="fe-num">{{ f.tf }}</b><span>a favor</span></div>
      <div><b class="fe-num">{{ f.tc }}</b><span>en contra</span></div>
      <div><b class="fe-num">{{ f.ef }}</b><span>ensayos</span></div>
    </div>
  </div>
  {% endif %}

  <div class="fe-doble">
    <div>
      <div class="fe-sub">Últimos partidos</div>
      {% for u in s.ultimos %}
      <div class="fe-res">
        {% if u.rival|escudo %}<img class="crest" src="{{ u.rival|escudo }}">{% else %}<span></span>{% endif %}
        <span class="rv">{{ u.rival|corto }}<small>{{ 'casa' if u.local else 'fuera' }}</small></span>
        <span class="mc fe-num">{{ u.pf }}-{{ u.pc }}</span>
        <span class="ch {{ u.res }}">{{ u.res }}</span>
      </div>
      {% else %}<div class="fe-vacio">Todavía no ha jugado</div>{% endfor %}
    </div>
    <div>
      <div class="fe-sub">Próximo partido</div>
      {% if s.proximo %}
      <div class="fe-prox">
        {% if s.proximo.rival|escudo %}<img class="crest" src="{{ s.proximo.rival|escudo }}">{% else %}<span></span>{% endif %}
        <div>
          <div class="rv fe-tit">{{ 'vs' if s.proximo.local else 'en casa de' }} {{ s.proximo.rival|corto }}</div>
          <div class="cu">J{{ s.proximo.jornada }} · {{ s.proximo.cuando }}</div>
          {% if s.proximo.campo %}<div class="ca">{{ s.proximo.campo|titulo }}</div>{% endif %}
        </div>
      </div>
      {% else %}<div class="fe-vacio">Sin fecha</div>{% endif %}
    </div>
  </div>

  {% if s.anotadores or s.ensayadores %}
  <div class="fe-doble">
    <div>
      <div class="fe-sub">Máximos anotadores</div>
      {% for j in s.anotadores %}<div class="fe-jug"><span class="n">{{ (j.nombre|jugador).completo }}</span><span class="v fe-num">{{ j.valor }}</span></div>{% endfor %}
    </div>
    <div>
      <div class="fe-sub">Ensayadores</div>
      {% for j in s.ensayadores %}<div class="fe-jug"><span class="n">{{ (j.nombre|jugador).completo }}</span><span class="v fe-num">{{ j.valor }}</span></div>
      {% else %}<div class="fe-vacio">Sin ensayos todavía</div>{% endfor %}
    </div>
  </div>
  {% endif %}
</div>
