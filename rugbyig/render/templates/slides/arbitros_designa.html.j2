{# Designaciones de la próxima jornada: cruce, árbitro y el récord (G-E-P) de
   cada equipo con ese árbitro. #}
<style>
.desig-fila { display: grid; grid-template-columns: 1fr 1fr; gap: 6px 30px; padding: 26px 0; }
.desig-fila + .desig-fila { border-top: 1px solid var(--linea); }
.desig-arb { grid-column: 1 / -1; font-family: var(--f-num); font-size-adjust: cap-height var(--aj-num); font-weight: 600; font-size: 40px; line-height: 1; }
.desig-arb small { font-family: var(--f-txt); font-size: 26px; font-weight: 500; color: var(--gris); margin-left: 10px; }
.desig-eq { display: flex; align-items: center; gap: 14px; min-width: 0; margin-top: 12px; }
.desig-eq .crest { width: 52px; height: 52px; padding: 5px; flex: none; }
.desig-nom { font-size: 28px; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; flex: 1; min-width: 0; }
.desig-rec { font-family: var(--f-num); font-size-adjust: cap-height var(--aj-num); font-weight: 700; font-size: 36px; font-variant-numeric: tabular-nums; white-space: nowrap; }
.desig-rec.vacio { font-family: var(--f-txt); font-weight: 500; font-size: 24px; color: var(--apagado); }
.f-historia .desig-fila { padding: 34px 0; }
</style>
<div class="titulo">
  <h1>{{ s.titulo }}</h1>
  <div class="bajada">{{ s.sup }}</div>
</div>
<div class="cuerpo">
{% for f in s.filas %}
  <div class="desig-fila">
    <div class="desig-arb">{{ f.arbitro }}<small>{{ f.local|corto }} – {{ f.visitante|corto }}</small></div>
    {% for lado in ['l', 'v'] %}
    {% set eq = f.local if lado == 'l' else f.visitante %}
    {% set rec = f['rec_' ~ lado] %}
    <div class="desig-eq">
      {% if eq|escudo %}<img class="crest" src="{{ eq|escudo }}">{% endif %}
      <span class="desig-nom">{{ eq|corto }}</span>
      <span class="desig-rec {{ 'vacio' if rec == 'sin partidos' }}">{{ rec }}</span>
    </div>
    {% endfor %}
  </div>
{% endfor %}
</div>
