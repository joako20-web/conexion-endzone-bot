<!doctype html>
<html lang="es">
<head>
<meta charset="utf-8">
<style>{{ fuentes|safe }}</style>
<style>
  :root {
  --rojo: #ff5a4f;
  --amarillo: #ffd23f;
  --z-titulo: #d4ff3d;
  --z-ascenso: #4fb3ff;
  --z-promocion: #ffb020;
  --z-descenso: #ff5a4f;
  --z-fase: #b48cff;
}
* { box-sizing: border-box; margin: 0; padding: 0; }
body { background: #000; font-family: var(--f-txt); font-size-adjust: cap-height var(--aj-txt); color: var(--texto); }
.slide {
  width: 1080px; height: 1350px; position: relative; overflow: hidden;
  background: var(--textura), var(--fondo);
  padding: 64px 64px 0; display: flex; flex-direction: column; margin-bottom: 20px;
}
/* Marca de agua del escudo, muy tenue */
.slide::after {
  content: ""; position: absolute; width: 900px; height: 900px; right: -330px; bottom: -300px;
  background: url("{{ logo }}") center/contain no-repeat; opacity: var(--marca-opacidad); filter: var(--marca-filtro); pointer-events: none;
}
.cabecera { display: flex; justify-content: space-between; align-items: flex-start; position: relative; z-index: 2; }
.etiqueta { font-weight: 600; font-size: 28px; letter-spacing: 3px; text-transform: uppercase; color: var(--acento-txt); padding-top: 18px; }
.escudo { display: flex; flex-direction: column; align-items: center; gap: 6px; }
.escudo img { width: 96px; height: 96px; border-radius: 50%; background: #fff; box-shadow: 0 0 0 3px rgba(255,255,255,.15); }
.escudo .flechas { font-family: var(--f-tit); font-size-adjust: cap-height var(--aj-tit); font-weight: 600; font-size: 40px; line-height: .6; letter-spacing: -6px; color: var(--texto); }

.titulo { text-align: center; margin-top: 8px; position: relative; z-index: 2; }
h1 { font-family: var(--f-tit); font-size-adjust: cap-height var(--aj-tit); font-weight: 600; font-size: calc(108px * var(--k-tit)); line-height: .82; padding: 0 70px; }
.bajada { font-size: 32px; color: var(--gris); margin-top: 12px; font-weight: 500; }
.cuerpo { flex: 1; margin-top: 40px; display: flex; flex-direction: column; position: relative; z-index: 2; }
.pie { height: 110px; display: flex; align-items: center; justify-content: center; position: relative; z-index: 2; }
.comp { font-weight: 600; font-size: 26px; letter-spacing: 3px; text-transform: uppercase; color: var(--gris); border: 2px solid var(--linea); border-radius: 999px; padding: 8px 24px; }
.comp b { color: var(--texto); }

/* Portada con foto (mismo formato que las noticias de la cuenta) */
.t-portada { padding: 0; }
.t-portada .foto { position: absolute; inset: 0; background-size: cover; background-position: center 18%; }
.t-portada .foto::after { content: ""; position: absolute; inset: 0;
  background: linear-gradient(180deg, rgba(10,10,10,.35) 0%, rgba(10,10,10,0) 22%, rgba(10,10,10,0) 40%, rgba(10,10,10,.85) 62%, var(--fondo) 76%); }
.t-portada .cabecera { padding: 64px 64px 0; }
.t-portada .etiqueta { background: var(--acento); color: var(--sobre-acento); padding: 8px 18px; border-radius: 6px; margin-top: 14px; }
.t-portada .texto { margin-top: auto; padding: 0 72px 0; text-align: center; position: relative; z-index: 2; }
.t-portada h1 { font-size: calc(200px * var(--k-tit)); line-height: .78; }
.t-portada h1 span { color: var(--acento-txt); }
.t-portada .bajada { font-size: 38px; color: var(--texto); line-height: 1.2; margin-top: 18px; }
.t-portada .credito { font-size: 28px; color: var(--gris); margin-top: 22px; letter-spacing: 1px; }
.t-portada .credito b { color: var(--acento-txt); font-weight: 600; }
.t-portada .mvp { position: relative; z-index: 2; margin: 40px 64px 0; padding: 40px 0 0; border-top: 3px solid var(--acento); text-align: center; }
.t-portada .mvp-motivo { font-weight: 600; font-size: 30px; letter-spacing: 4px; text-transform: uppercase; color: var(--acento-txt); }
.t-portada .mvp-pila { font-family: var(--f-tit); font-size-adjust: cap-height var(--aj-tit); font-weight: 400; font-size: 84px; line-height: .9; margin-top: 30px; color: var(--gris); }
.t-portada .mvp-apellido { font-family: var(--f-tit); font-size-adjust: cap-height var(--aj-tit); font-weight: 700; font-size: 180px; line-height: .78; text-transform: uppercase; }
.t-portada .mvp-datos { display: flex; justify-content: center; gap: 18px; margin-top: 28px; font-size: 30px; font-weight: 600; }
.t-portada .mvp-equipo { background: var(--texto); color: var(--fondo); padding: 4px 16px; border-radius: 6px; }
.t-portada .mvp-pos { color: var(--gris); padding: 4px 0; }
.t-portada .mvp-linea { margin-top: 22px; font-size: 32px; color: var(--gris); }
.t-portada .mvp-linea b { color: var(--texto); }
.t-portada .sin-foto { position: absolute; top: 120px; left: 0; right: 0; text-align: center; font-family: var(--f-tit); font-size-adjust: cap-height var(--aj-tit); font-weight: 700; font-size: 760px; line-height: 1; color: var(--acento-txt); opacity: .9; }

/* El dato de la jornada */
.dato { justify-content: center; align-items: center; text-align: center; margin-top: 0; }
.dato-kicker { font-weight: 600; font-size: 30px; letter-spacing: 4px; text-transform: uppercase; color: var(--acento-txt); }
.dato-num { font-family: var(--f-tit); font-size-adjust: cap-height var(--aj-tit); font-weight: 700; font-size: 420px; line-height: .78; color: var(--acento-txt); margin-top: 40px; }
.dato-num.largo { font-size: 300px; }
.dato-unidad { font-family: var(--f-tit); font-size-adjust: cap-height var(--aj-tit); font-weight: 500; font-size: 64px; line-height: .9; text-transform: uppercase; margin-top: 4px; }
.dato-titular { font-family: var(--f-tit); font-size-adjust: cap-height var(--aj-tit); font-weight: 600; font-size: 76px; line-height: .95; margin-top: 56px; padding: 0 20px; }
.dato-contexto { font-size: 34px; color: var(--gris); margin-top: 22px; line-height: 1.25; padding: 0 30px; }

/* Resultado final en directo (historia) */
.final { align-items: center; text-align: center; }
.final-tag { display: inline-block; background: var(--acento); color: var(--sobre-acento); font-family: var(--f-tit); font-size-adjust: cap-height var(--aj-tit); font-weight: 600; font-size: 64px; line-height: 1; padding: 14px 34px 6px; border-radius: 10px; }
.final-sub { font-size: 30px; color: var(--gris); margin-top: 18px; letter-spacing: 1px; }
.final-equipos { display: grid; grid-template-columns: 1fr 1fr; width: 100%; margin-top: 70px; gap: 24px; }
.final-eq { display: flex; flex-direction: column; align-items: center; }
.final-eq img { width: 230px; height: 230px; padding: 22px; }
.final-eq .nom { font-family: var(--f-num); font-size-adjust: cap-height var(--aj-num); font-weight: 500; font-size: 58px; line-height: .9; margin-top: 22px; }
.final-eq.pierde .nom { color: var(--apagado); }
.final-marcador { font-family: var(--f-num); font-size-adjust: cap-height var(--aj-num); font-weight: 700; font-size: 300px; line-height: .8; margin-top: 50px; }
.final-marcador .g { color: var(--acento-txt); }
.final-marcador .p { color: var(--apagado); }
.final-marcador .sep { color: var(--linea); margin: 0 14px; }
.final-anot { display: grid; grid-template-columns: 1fr 1fr; width: 100%; margin-top: 60px; gap: 40px; text-align: left; }
.final-anot ul { list-style: none; }
.final-anot li { font-size: 30px; line-height: 1.25; margin-bottom: 14px; }
.final-anot li b { font-family: var(--f-num); font-size-adjust: cap-height var(--aj-num); font-weight: 500; font-size: 40px; display: block; line-height: .9; }
.final-anot li span { color: var(--gris); font-size: 28px; }
.final-anot .vis { text-align: right; }
.final-nota { font-size: 28px; color: var(--gris); margin-top: 40px; }

/* Todos los grupos */
.grupos { display: grid; grid-template-columns: 1fr 1fr; gap: 22px 34px; }
.grupo-tit { font-family: var(--f-tit); font-size-adjust: cap-height var(--aj-tit); font-weight: 600; font-size: 40px; color: var(--acento-txt); border-bottom: 2px solid var(--linea); padding-bottom: 4px; margin-bottom: 4px; }
.gfila { display: grid; grid-template-columns: 30px 46px 1fr 34px 46px; align-items: center; gap: 8px; height: 62px; border-bottom: 1px solid var(--linea); position: relative; }
.compacto .gfila { height: 43px; grid-template-columns: 26px 36px 1fr 30px 40px; }
.gpos { font-family: var(--f-num); font-size-adjust: cap-height var(--aj-num); font-size: 32px; color: var(--gris); padding-top: 4px; }
.geq { font-family: var(--f-num); font-size-adjust: cap-height var(--aj-num); font-weight: 500; font-size: 34px; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; padding-top: 4px; }
.compacto .geq { font-size: 28px; }
.gpj { font-size: 26px; color: var(--gris); text-align: right; }
.gpt { font-family: var(--f-num); font-size-adjust: cap-height var(--aj-num); font-weight: 600; font-size: 38px; color: var(--acento-txt); text-align: right; padding-top: 4px; }
.gfila[class*="z-"]::before { content: ""; position: absolute; left: -12px; top: 8px; bottom: 8px; width: 6px; border-radius: 3px; background: var(--zc); }
.crest.g { width: 42px; height: 42px; padding: 4px; }
.compacto .crest.g { width: 34px; height: 34px; padding: 3px; }
.exentos { margin-top: 28px; text-align: center; font-size: 26px; color: var(--gris); display: flex; justify-content: center; align-items: center; gap: 8px; flex-wrap: wrap; }
.exentos b { color: var(--texto); font-weight: 600; }

/* Cuadro de eliminatorias */
.cuadro { flex: 1; display: flex; gap: 22px; }
.ronda { flex: 1; display: flex; flex-direction: column; min-width: 0; }
.ronda-tit { font-weight: 600; font-size: 26px; letter-spacing: 3px; text-transform: uppercase; color: var(--acento-txt); text-align: center; margin-bottom: 10px; }
.cruces { flex: 1; display: flex; flex-direction: column; justify-content: space-around; }
.cuadro .cruce { background: var(--panel); border: 2px solid var(--linea); border-radius: 14px; padding: 6px 14px; position: relative; }
.ronda:not(:last-child) .cruce::after { content: ""; position: absolute; right: -24px; top: 50%; width: 22px; border-top: 2px solid var(--linea); }
.ronda:not(:first-child) .cruce::before { content: ""; position: absolute; left: -24px; top: 50%; width: 22px; border-top: 2px solid var(--linea); }
.cuadro .cruce.final { border-color: var(--acento); }
.ceq { display: flex; align-items: center; gap: 8px; height: 58px; }
.ceq + .ceq { border-top: 1px solid var(--linea); }
.cnom { flex: 1; font-family: var(--f-num); font-size-adjust: cap-height var(--aj-num); font-weight: 500; font-size: 34px; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; padding-top: 4px; }
.cpts { font-family: var(--f-num); font-size-adjust: cap-height var(--aj-num); font-weight: 600; font-size: 40px; padding-top: 4px; }
.cpos { font-size: 26px; color: var(--gris); width: 30px; }
.ceq.gana .cnom, .ceq.gana .cpts { color: var(--acento-txt); }
.ceq.pierde { opacity: .45; }
.campeon { display: flex; align-items: center; justify-content: center; gap: 22px; margin-bottom: 30px; }
.campeon img { width: 110px; height: 110px; padding: 10px; }
.campeon span { display: block; font-size: 26px; letter-spacing: 4px; text-transform: uppercase; color: var(--acento-txt); }
.campeon b { font-family: var(--f-tit); font-size-adjust: cap-height var(--aj-tit); font-weight: 600; font-size: 80px; line-height: .9; }

/* Formato historia 9:16: márgenes para la interfaz de Instagram (arriba y abajo) */
.f-historia { height: 1920px; padding: 210px 64px 150px; }
.f-historia .cuerpo { justify-content: flex-start; margin-top: 110px; }
.f-historia .cuerpo.dato, .f-historia .cuerpo.final { justify-content: center; margin-top: 0; }
.f-historia .flechas { display: none; }
.f-historia.t-portada { padding: 0 0 150px; }
.f-historia.t-portada .cabecera { padding-top: 210px; }
.f-historia.t-portada .mvp { margin-top: 140px; }
.f-historia .campo { flex: none; height: 1180px; }

/* Escudos de los clubes: siempre en círculo blanco (vienen con fondo blanco) */
.crest { border-radius: 50%; background: #fff; object-fit: contain; flex: none; }
.crest.r { width: 76px; height: 76px; padding: 8px; }
.crest.c { width: 54px; height: 54px; padding: 5px; vertical-align: middle; margin-right: 16px; }
.crest.a { width: 62px; height: 62px; padding: 6px; }
.crest.p { width: 44px; height: 44px; padding: 4px; vertical-align: middle; margin-right: 12px; position: relative; top: -4px; }
.crest.x { width: 30px; height: 30px; padding: 3px; vertical-align: middle; margin-right: 6px; }
.crest.m { width: 150px; height: 150px; padding: 16px; margin: 0 auto 26px; display: block; }

/* Resultados */
.partido { display: grid; grid-template-columns: 1fr 260px 1fr; align-items: center; height: 150px; border-bottom: 2px solid var(--linea); }
.partido:last-of-type { border-bottom: 0; }
.equipo { min-width: 0; display: flex; align-items: center; gap: 18px; }
.equipo.vis { justify-content: flex-end; text-align: right; }
.equipo .nom { font-family: var(--f-num); font-size-adjust: cap-height var(--aj-num); font-weight: 500; font-size: 54px; line-height: .9; }
.equipo.pierde .nom { color: var(--apagado); }
.marcador { text-align: center; font-family: var(--f-num); font-size-adjust: cap-height var(--aj-num); font-weight: 600; font-size: 104px; line-height: 1; padding-top: 10px; }
.marcador .g { color: var(--acento-txt); }
.marcador .p { color: var(--apagado); }
.marcador .sep { color: var(--linea); margin: 0 8px; }
.pend { font-size: 38px; color: var(--gris); font-family: var(--f-txt); font-size-adjust: cap-height var(--aj-txt); }
.nota-pie { font-size: 26px; color: var(--gris); margin-top: auto; padding-bottom: 12px; text-align: center; }

/* Rankings */
.fila { display: grid; grid-template-columns: 50px 62px 1fr auto; align-items: center; gap: 22px; height: 116px; border-bottom: 2px solid var(--linea); }
.fila:first-child { background: var(--acento); color: var(--sobre-acento); border-radius: 14px; border: 0; padding: 0 28px; margin: 0 -28px 10px; height: 140px; }
.fila:first-child .jug-eq, .fila:first-child .det { color: var(--sobre-acento-suave); }
.fila:first-child .pts { font-size: 116px; }
.pos { font-family: var(--f-num); font-size-adjust: cap-height var(--aj-num); font-weight: 600; font-size: 52px; color: var(--apagado); padding-top: 8px; }
.fila:first-child .pos { color: var(--sobre-acento); }
.jug-nom { font-family: var(--f-num); font-size-adjust: cap-height var(--aj-num); font-weight: 500; font-size: 52px; line-height: .9; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
.jug-eq { font-size: 28px; color: var(--gris); margin-top: 2px; }
.pts { font-family: var(--f-num); font-size-adjust: cap-height var(--aj-num); font-weight: 600; font-size: 84px; text-align: right; line-height: .85; padding-top: 10px; }
.pts small { font-size: 30px; margin-left: 6px; }
.det { font-size: 26px; text-align: right; color: var(--gris); margin-top: 2px; }

/* XV ideal */
.campo { flex: 1; margin: 0 -20px 10px; border-radius: 22px; position: relative; display: flex; flex-direction: column; justify-content: space-evenly; padding: 6px 0;
  background: repeating-linear-gradient(180deg, transparent 0 20%, var(--linea) 20% calc(20% + 2px)), var(--panel);
  border: 2px solid var(--linea); }
.campo .fila-xv { display: flex; justify-content: center; gap: 26px; }
.ficha { width: 190px; display: flex; flex-direction: column; align-items: center; text-align: center; }
.ficha .dorsal { width: 58px; height: 58px; border-radius: 50%; background: var(--texto); color: var(--fondo); display: grid; place-items: center; font-family: var(--f-num); font-size-adjust: cap-height var(--aj-num); font-weight: 600; font-size: 40px; padding-top: 6px; }
.ficha.top .dorsal { background: var(--acento); color: var(--sobre-acento); }
.ficha .n1 { font-size: 24px; color: var(--gris); margin-top: 6px; white-space: nowrap; }
.ficha .n2 { font-family: var(--f-num); font-size-adjust: cap-height var(--aj-num); font-weight: 500; font-size: 36px; line-height: .85; white-space: nowrap; max-width: 200px; overflow: hidden; text-overflow: ellipsis; }
.ficha .n2.l { font-size: 31px; }
.ficha .n2.xl { font-size: 28px; }
.ficha .eq { display: flex; align-items: center; margin-top: 4px; font-size: 24px; font-weight: 700; letter-spacing: 1.5px; color: var(--acento-txt); }

/* Clasificación */
table { width: 100%; border-collapse: collapse; table-layout: fixed; }
th { font-weight: 600; font-size: 26px; letter-spacing: 2px; color: var(--gris); text-align: center; padding-bottom: 10px; border-bottom: 2px solid var(--linea); }
th.izq, td.izq { text-align: left; }
td { height: 84px; text-align: center; font-family: var(--f-num); font-size-adjust: cap-height var(--aj-num); font-weight: 500; font-size: 44px; border-bottom: 1px solid var(--linea); padding-top: 8px; }
td.eq { font-size: 44px; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
td.pt { color: var(--acento-txt); font-weight: 600; font-size: 52px; }
td.p, th.p { color: var(--gris); width: 60px; }
td.n, th.n { width: 58px; }
td.dif, th.dif { width: 96px; }
td.pt, th.pt { width: 92px; }
td { height: 75px; }
td.p { position: relative; }
tr[class^="z-"] td.p::before { content: ""; position: absolute; left: -14px; top: 10px; bottom: 10px; width: 8px; border-radius: 4px; background: var(--zc); }
tr[class^="z-"] td.p { color: var(--zc); }
.z-titulo { --zc: var(--z-titulo); } .z-ascenso { --zc: var(--z-ascenso); }
.z-promocion { --zc: var(--z-promocion); } .z-descenso { --zc: var(--z-descenso); } .z-fase { --zc: var(--z-fase); }
.leyenda { display: flex; flex-wrap: wrap; justify-content: center; gap: 12px 34px; margin-top: 26px; }
.ley { display: inline-flex; align-items: center; gap: 12px; font-size: 27px; font-weight: 500; color: var(--gris); }
.ley i { width: 8px; height: 30px; border-radius: 4px; background: var(--zc); }

/* Previa */
.previa { display: grid; grid-template-columns: 170px 1fr; align-items: center; border-bottom: 2px solid var(--linea); padding: 20px 0; gap: 28px; }
.previa:last-child { border-bottom: 0; }
.previa .dia { font-weight: 600; font-size: 26px; color: var(--acento-txt); letter-spacing: 2px; text-transform: uppercase; }
.previa .hora { font-family: var(--f-num); font-size-adjust: cap-height var(--aj-num); font-weight: 600; font-size: 72px; line-height: .85; }
.previa .cruce { font-family: var(--f-num); font-size-adjust: cap-height var(--aj-num); font-weight: 500; font-size: 50px; line-height: .9; white-space: nowrap; }
.previa .cruce span { color: var(--gris); font-family: var(--f-txt); font-size-adjust: cap-height var(--aj-txt); font-size: 28px; margin-right: 12px; }
.previa .lugar { font-size: 26px; color: var(--gris); margin-top: 6px; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
{% include "temas.css" %}
</style>
</head>
<body class="tema-{{ tema }}">
{% for s in slides %}
<section class="slide t-{{ s.tipo }} f-{{ formato }}">
  {% if s.tipo == "portada" and s.foto %}<div class="foto" style="background-image:url('{{ s.foto }}')"></div>{% endif %}
  <div class="cabecera">
    <div class="etiqueta">{{ comp.corto }}{% if comp.grupo %} · {{ comp.grupo }}{% endif %}{% if jornada %} · Jornada {{ jornada }}{% endif %}</div>
    <div class="escudo">
      <img src="{{ logo }}" alt="">
      {% if not loop.last %}<div class="flechas">»</div>{% endif %}
    </div>
  </div>
  {% include "slides/" ~ s.tipo ~ ".html.j2" %}
  {% if s.tipo != "portada" %}
  <div class="pie"><span class="comp"><b>{{ comp.nombre }}</b> · {{ temporada }}</span></div>
  {% endif %}
</section>
{% endfor %}
</body>
</html>
